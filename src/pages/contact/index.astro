---
import Layout from '@/layouts/Layout.astro';
import SubKv from '@/components/SubKv.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const pageTitle = 'お問い合わせ';
const pageSlug = 'contact';
---

<Layout pageTitle={pageTitle} pageSlug={pageSlug}>
  <SubKv pageTitle={pageTitle} />
  <Breadcrumb pageTitle={pageTitle} pageUrl={pageSlug} />
  <main>
    <section>
      <div class="u-inner">お問い合わせのコンテンツ</div>
    </section>
  </main>
</Layout>
