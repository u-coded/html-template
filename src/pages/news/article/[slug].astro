---
// ニュース記事詳細ページ
// URL: /news/article/[slug]/

import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import SubKv from '@/components/SubKv.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import noImage from '@/assets/common/img_noimage.jpg';

const useMicroCMS = import.meta.env.USE_MICROCMS === 'true';

export async function getStaticPaths() {
  const posts = (await getCollection('news')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;

// 本文：Markdownは Content コンポーネント / microCMSは HTML 文字列
const MarkdownContent = useMicroCMS ? null : (await render(post)).Content;
const microCmsBody = useMicroCMS
  ? ((post.data as { body?: string }).body ?? '')
  : null;

const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Layout pageTitle={post.data.title} pageSlug="news-article">
  <SubKv pageTitle="お知らせ" />
  <Breadcrumb
    pageTitle={post.data.title}
    pageUrl={`news/article/${post.id}`}
    parentPageTitle="お知らせ"
    parentPageUrl="news"
  />
  <main>
    <article class="p-news-article">
      <div class="p-news-article__inner u-inner">
        <header class="p-news-article__header">
          <time
            class="p-news-article__date"
            datetime={post.data.pubDate.toISOString().slice(0, 10)}
          >
            {formatDate(post.data.pubDate)}
          </time>
          <h3 class="p-news-article__title">{post.data.title}</h3>
        </header>
        <div class="p-news-article__cover">
          {
            post.data.thumbnail ? (
              <Image
                src={post.data.thumbnail.url}
                alt=""
                width={post.data.thumbnail.width}
                height={post.data.thumbnail.height}
                format="webp"
              />
            ) : (
              <Image src={noImage} alt="" format="webp" width={1200} />
            )
          }
        </div>
        <div class="p-news-article__content">
          {
            useMicroCMS ? (
              <Fragment set:html={microCmsBody} />
            ) : (
              MarkdownContent && <MarkdownContent />
            )
          }
        </div>
        <nav class="c-pager2 u-font-bold" aria-label="Post Navigation">
          <div class="c-pager2__prev">
            {
              prev && (
                <a
                  href={`/news/article/${prev.id}/`}
                  class="u-alpha"
                  aria-label={`Previous Post: ${prev.data.title}`}
                >
                  <span>＜ 前の記事</span>
                </a>
              )
            }
          </div>
          <div class="c-pager2__back">
            <a href="/news/" class="c-btn2">一覧へ戻る</a>
          </div>
          <div class="c-pager2__next">
            {
              next && (
                <a
                  href={`/news/article/${next.id}/`}
                  class="u-alpha"
                  aria-label={`Next Post: ${next.data.title}`}
                >
                  <span>次の記事 ＞</span>
                </a>
              )
            }
          </div>
        </nav>
      </div>
    </article>
  </main>
</Layout>
